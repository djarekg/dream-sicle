{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/apps/Api/bin/Debug/net10.0/Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/apps/Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "ng: serve",
      "type": "editor-browser",
      "request": "launch",
      "preLaunchTask": "bun: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "ng: test",
      "type": "editor-browser",
      "request": "launch",
      "preLaunchTask": "bun: test",
      "url": "http://localhost:9876/debug.html"
    }
  ],
  "compounds": [
    {
      "name": "debug: api + ng",
      "configurations": [".NET API", "ng: serve"],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "2",
        "order": 1
      }
    }
  ]
}
